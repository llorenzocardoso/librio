rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Regras para imagens de perfil
    match /profile_images/{imageId} {
      // Permitir leitura para usuários autenticados
      allow read: if request.auth != null;

      // Permitir upload apenas do próprio usuário
      // O nome do arquivo deve conter o UID do usuário
      allow write: if request.auth != null
        && imageId.matches('profile_' + request.auth.uid + '_.*');

      // Permitir deleção apenas do próprio usuário
      allow delete: if request.auth != null
        && imageId.matches('profile_' + request.auth.uid + '_.*');
    }

    // Regras para imagens de livros
    match /book_images/{imageId} {
      // Permitir leitura pública para que todos possam ver as capas dos livros
      allow read: if true;

      // Permitir upload apenas do próprio usuário
      // O nome do arquivo deve conter o UID do usuário
      allow write: if request.auth != null
        && imageId.matches('book_' + request.auth.uid + '_.*');

      // Permitir deleção apenas do próprio usuário
      allow delete: if request.auth != null
        && imageId.matches('book_' + request.auth.uid + '_.*');
    }
  }
}
